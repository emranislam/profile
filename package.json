{
  "name": "emran-islam-profile",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i src/index.css -o assets/app.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --format=esm --jsx=automatic --loader:.css=empty --define:process.env.NODE_ENV=\\\"production\\\" --outfile=assets/app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.17"
  }
}
